{
  "name": "idle-rpg",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p tsconfig.tests.json",
    "test": "npm run check && vitest run --exclude \"src/lib/game/__tests__/balance.test.ts\" --exclude \"src/lib/game/__tests__/run.test.ts\"",
    "test:balance": "vitest run src/lib/game/__tests__/balance.test.ts src/lib/game/__tests__/run.test.ts",
    "test:balance:sample": "BALANCE_SAMPLE=1 npm run test:balance",
    "test:visual": "playwright test",
    "test:all": "npm run test && npm run test:balance && npm run test:visual",
    "content:check": "vitest run src/lib/data/__tests__/integrity.test.ts",
    "screenshots": "npm run test:visual",
    "screenshots:update": "playwright test --update-snapshots",
    "presets:update": "UPDATE_PRESETS=1 vitest run src/lib/game/__tests__/presets.test.ts",
    "icons:build": "node scripts/build-icons.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.3",
    "@types/three": "^0.185.4",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "break_infinity.js": "^2.2.0",
    "three": "^0.185.1"
  }
}
